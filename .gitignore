# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# The over-the-air update certificate is public and ships inside the app; its private key
# lives only in the release secrets (tooling/release-mobile/ota-server/README.md).
!certs/certificate.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
modules/ghostex-native/android/build/

# gomobile tailcat bridge output, built by apps/mobile/tailcat-bridge/build.sh
# and by the Android release job. Never commit these: the .so files are ~35 MB
# per ABI and are reproducible from the committed Go source.
modules/ghostex-native/android/libs/tailcatbridge.jar
modules/ghostex-native/android/src/main/jniLibs/
modules/ghostex-native/ios/Vendor/Tailcatbridge.xcframework/

# The chat core as WebAssembly in one page (cargo xtask build-mobile-chat-wasm in the main repo,
# from packages/gx-chat-wasm), for the hidden WebView core. Reproducible; the page is ~5.5 MB.
assets/chat-core/
