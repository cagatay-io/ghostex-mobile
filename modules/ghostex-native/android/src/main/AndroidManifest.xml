<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The SSH transport (SSHJ) needs network access; merged into the app manifest. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Persistent foreground-service notification (ported from the Termux fork). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <!-- Voice mode (the manager voice agent and Grok dictation): the microphone, the call audio
       mode and route, and the foreground service's microphone type that keeps a conversation
       going with the screen locked. -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

  <!-- Android 11+ package visibility for opening the installed Tailscale app. -->
  <queries>
    <package android:name="com.tailscale.ipn" />
  </queries>

  <application>
    <service
        android:name="expo.modules.ghostexnative.GhostexForegroundService"
        android:exported="false"
        android:foregroundServiceType="specialUse|microphone">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Keeps user-started Ghostex remote terminal sessions and SSH attach processes visible while the user switches between persistent ZMX sessions." />
    </service>
  </application>
</manifest>
